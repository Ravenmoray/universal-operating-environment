{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ravenmoray/universal-operating-environment/blob/main/experiments/capability-graph/schema-v0.json",
  "title": "UOE Experimental Capability Graph v0.1.0",
  "description": "Experimental graph only; schema validity or a passing fixture does not establish real-world compatibility or evidence authenticity.",
  "type": "object",
  "required": [
    "schema_version",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "artifact",
              "capability",
              "provider",
              "host",
              "evidence"
            ]
          },
          "label": {
            "type": "string"
          },
          "evidence_type": {
            "enum": [
              "inspection",
              "specification",
              "test",
              "model_hypothesis",
              "operator_claim"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "scope": {
            "type": "object",
            "required": [
              "source",
              "relationship",
              "target"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "relationship": {
                "enum": [
                  "requires",
                  "provides",
                  "available_on"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "evidence"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "evidence_type",
                "reference",
                "result",
                "scope"
              ]
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "relationship",
          "target",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "enum": [
              "requires",
              "provides",
              "available_on"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "inferred",
              "documented",
              "observed",
              "tested",
              "rejected"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
